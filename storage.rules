rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'pOGN5R17jRXBAxUHHWcb2kTqn2w1';
    }

    match /notes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'pOGN5R17jRXBAxUHHWcb2kTqn2w1';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
